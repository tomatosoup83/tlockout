# Copy this file to .deploy.env and fill in your PebbleHost SFTP credentials.
# .deploy.env is gitignored — never commit your real password.
# Tip: run `chmod 600 .deploy.env` after creating it.

# PebbleHost SFTP host (from Panel -> Files -> SFTP Details)
SFTP_HOST='sftp.pebblehost.com'

# PebbleHost SFTP port (usually 2222 or 2022)
SFTP_PORT='2222'

# SFTP username (usually your panel username + server ID)
SFTP_USER='youruser.123456'

# SFTP password — keep single quotes so characters like $, !, # are kept literal
SFTP_PASS='your-sftp-password'

# Remote plugins directory on the server (PebbleHost chroot root is /plugins)
SFTP_REMOTE_DIR='/plugins'

# Host key verification:
# Leave false (recommended) and trust the host key once with:
#   mkdir -p ~/.ssh && ssh-keyscan -p <PORT> <HOST> >> ~/.ssh/known_hosts
# Set to true only if you want curl to skip known_hosts verification (-k).
SFTP_INSECURE='false'
